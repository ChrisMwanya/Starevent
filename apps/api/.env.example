NODE_ENV=development
PORT=4000

# Origines autorisées (frontend Next.js), séparées par des virgules
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (docker-compose.yml à la racine)
DATABASE_URL=postgres://starevent:starevent@127.0.0.1:5434/starevent

# Images du back-office, stockées sur Cloudinary (console Cloudinary → Settings → API Keys)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=starevent

# Site Next.js à prévenir après une modification de contenu ; même valeur que REVALIDATE_SECRET dans apps/web/.env.local
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=

# Notification email à l'équipe via Resend (laisser RESEND_API_KEY vide pour désactiver l'envoi en dev)
# MAIL_FROM doit utiliser un domaine vérifié dans Resend ; MAIL_TO accepte plusieurs adresses séparées par des virgules
RESEND_API_KEY=
MAIL_FROM="Star Event <no-reply@starevent.cd>"
MAIL_TO=

